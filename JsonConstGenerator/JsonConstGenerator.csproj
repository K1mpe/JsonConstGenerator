<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<OutputItemType>Analyzer</OutputItemType>
		<EnableDefaultItems>false</EnableDefaultItems>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
		<CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)\Generated</CompilerGeneratedFilesOutputPath>
		<IsRoslynComponent>true</IsRoslynComponent>

		<!-- Pack the generator DLL as an analyzer, not a normal lib reference, so
		     consumers get it as a compiler component instead of an assembly reference. -->
		<IncludeBuildOutput>false</IncludeBuildOutput>
		<NoWarn>$(NoWarn);NU5128</NoWarn>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<FileAlignment>512</FileAlignment>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<FileAlignment>512</FileAlignment>
	</PropertyGroup>

	<ItemGroup>
		<Compile Include="Diagnostics.cs" />
		<Compile Include="GeneratorInput.cs" />
		<Compile Include="Helpers\GeneratorHelper.cs" />
		<Compile Include="Helpers\JsonMerger.cs" />
		<Compile Include="Helpers\MiniJSON.cs" />
		<Compile Include="JsonConstGenerator.cs" />
		<Compile Include="Validation.cs" />
	</ItemGroup>

	<ItemGroup>
	  <None Include="README.md" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" Version="4.13.0" />
		<PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" Version="4.13.0" />
	</ItemGroup>
	<ItemGroup>
	  <ProjectReference Include="..\JsonConstGenerator.Abstraction\JsonConstGenerator.Abstraction.csproj" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<!-- JsonConstGenerator.Abstraction is not packable/published on its own (IsPackable=false);
		     its build output is bundled here as a normal lib reference so consumer code can resolve
		     JsonConstGeneratorAttribute, IConstNode, ValueConstNode<T>, etc. from a single package install. -->
		<None Include="$(OutputPath)\JsonConstGenerator.Abstraction.dll" Pack="true" PackagePath="lib/netstandard2.0" Visible="false" />
		<None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
	</ItemGroup>
</Project>

